{
  "port": 8788,
  "syncToMemory": true,
  "autoWatch": true,
  "autoCalibrate": true,
  "autoTask": true,
  "agents": {
    "workbuddy": {
      "label": "WorkBuddy",
      "memoryDir": ".workbuddy/memory",
      "backlogFile": "改造清单.md",
      "contextFiles": ["MEMORY.md"],
      "syncFile": "MEMORY.md",
      "dailyPattern": "^\\d{4}-\\d{2}-\\d{2}\\.md$",
      "dailyFile": "{date}.md"
    }
  },
  "projects": [
    {
      "id": "sample-web",
      "name": "sample-web 示例站点",
      "projectRoot": "{{DEMO}}/sample-web",
      "memoryRoot": "{{DEMO}}/sample-web",
      "agent": "workbuddy"
    },
    {
      "id": "sample-cli",
      "name": "sample-cli 示例工具",
      "projectRoot": "{{DEMO}}/sample-cli",
      "memoryRoot": "{{DEMO}}/sample-cli",
      "agent": "workbuddy"
    }
  ]
}
